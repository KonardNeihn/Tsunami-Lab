netcdf netcdf_output {
dimensions:
	time = UNLIMITED ; // (15 currently)
	x = 100 ;
	y = 100 ;
variables:
	float time(time) ;
		time:units = "seconds since the earthquake event" ;
		time:standard_name = "time" ;
	float x(x) ;
		x:units = "meters" ;
		x:long_name = "x-coordinate of cell centers" ;
		x:axis = "X" ;
	float y(y) ;
		y:units = "meters" ;
		y:long_name = "y-coordinate of cell centers" ;
		y:axis = "Y" ;
	float b(y, x) ;
		b:long_name = "bathymetry (seafloor elevation)" ;
		b:units = "meters" ;
	float h(time, y, x) ;
		h:long_name = "water height above bathymetry" ;
		h:units = "meters" ;
	float hu(time, y, x) ;
		hu:long_name = "x-momentum (h * u)" ;
		hu:units = "meters^2 / second" ;
	float hv(time, y, x) ;
		hv:long_name = "y-momentum (h * v)" ;
		hv:units = "meters^2 / second" ;

